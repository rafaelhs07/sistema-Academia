# Public API values, from the intended environment's Supabase project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Canonical application URL, also configure it in Supabase Auth redirect URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Server only: invitations/bootstrap. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Server only: protected daily billing job. Use at least 32 random characters.
CRON_SECRET=
# Cron refuses to run unless explicitly enabled for this deployment.
ENABLE_BILLING_CRON=false
# Independent platform subscriptions; academy suspension never pauses this job.
ENABLE_PLATFORM_BILLING_CRON=false
